meta {
  name: Register user
  type: http
}

request {
  method: POST
  url: http://localhost:8080/api/auth/register
  body: json
  json: {
    "username": "john_doe",
    "password": "12345",
    "name": "John Doe",
    "age": 25,
    "location": "New York",
    "gender": "Male",
    "interests": ["music", "travel", "sports"],
    "creatorType": "influencer",
    "audienceSize": 5000
  }
  headers: {
    Content-Type: application/json
  }
}

