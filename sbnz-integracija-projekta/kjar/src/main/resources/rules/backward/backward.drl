package backward

import com.ftn.sbnz.model.models.User
import com.ftn.sbnz.model.models.Post
import com.ftn.sbnz.model.models.Recommendation

// Query: Does the post match the user's interests?
query "isRelevantFor"(Post $post, User $user)
    (
        // Direct match - post category is in user's interests
        eval($user.getInterests().contains($post.getCategory()))
    )
    or
    (
        // Recursive case - similar post is relevant
        $similarPost: Post(
            category == $post.getCategory(),
            contentType == $post.getContentType(),
            id != $post.getId()
        )
        and
        isRelevantFor($similarPost, $user;)
    )
end

// Rule that uses backward chaining query
rule "Find Relevant Content"
    when
        $user: User($userId: id)
        $post: Post($postUserId: user.id, $postUserId != $userId)
        // Call backward query
        ?isRelevantFor($post, $user;)
        not Recommendation(user.id == $userId, post.id == $post.id)
    then
        Recommendation rec = new Recommendation();
        rec.setUser($user);
        rec.setPost($post);
        rec.setContentType($post.getContentType());
        rec.setCategory($post.getCategory());
        rec.setContent($post.getContent());
        rec.setPriorityScore(6.0);
        rec.setReasoning("Found via backward chaining");
        insert(rec);
        System.out.println("✓ Backward: Recommendation for " + $user.getName() +
                          " -> " + $post.getCategory());
end

// Recursive query for finding "chain" of connected posts
query "isConnectedTo"(Post $post1, Post $post2)
    // Base case - posts share the same category
    (
        eval($post1.getCategory().equals($post2.getCategory()) &&
             !$post1.getId().equals($post2.getId()))
    )
    or
    // Recursive case - connected through intermediate post
    (
        $mid: Post(
            category == $post1.getCategory(),
            id != $post1.getId()
        )
        and
        isConnectedTo($mid, $post2;)
    )
end

// Find all posts connected to a given post
rule "Find Connected Content"
    when
        $trigger: String(this == "findConnected")
        $user: User($userId: id)
        $startPost: Post(
            $category: category,
            category memberOf $user.getInterests()
        )
        ?isConnectedTo($startPost, $connectedPost;)
        not Recommendation(user.id == $userId, post.id == $connectedPost.id)
    then
        Recommendation rec = new Recommendation();
        rec.setUser($user);
        rec.setPost($connectedPost);
        rec.setContentType($connectedPost.getContentType());
        rec.setCategory($connectedPost.getCategory());
        rec.setContent($connectedPost.getContent());
        rec.setPriorityScore(5.5);
        rec.setReasoning("Connected through content chain");
        insert(rec);
        System.out.println("✓ Found connected post: " + $connectedPost.getCategory());
end