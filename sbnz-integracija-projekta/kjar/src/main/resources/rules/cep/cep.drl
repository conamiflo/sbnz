declare Overposting
  category : String
end
declare ShareDrop
  category : String
end
declare NoRescueSignal
  category : String
end

// ========= A) Overposting: ≥ 8 postova iste kategorije u 48h =========
rule "A_overposting_48h"
when
  PostPublishedEvent( $cat : category ) over window:time(48h)
  Number( intValue >= 8 ) from accumulate(
    PostPublishedEvent( category == $cat ) over window:time(48h), count(1)
  )
  not Overposting( category == $cat )
then
  System.out.println(">>> Rule A Fired for category: " + $cat);
  insert( new Overposting($cat) );
end

// ========= B) ShareDrop: recent 7d < 0.6 * baseline 30d =========
rule "B_share_drop_recent_vs_baseline"
when
    PostPublishedEvent( $cat : category ) over window:time(30d)
    $basePostCount : Number( intValue > 0 ) from accumulate(
        PostPublishedEvent( category == $cat ) over window:time(30d), count(1)
    )
    $recentShareCount : Number() from accumulate(
        EngagementEvent( postCategory == $cat, type == EngagementType.SHARE ) over window:time(7d), count(1)
    )
    $recentPostCountNum : Number() from accumulate(
        PostPublishedEvent( category == $cat ) over window:time(7d), count(1)
    )
    $baseShareCount : Number() from accumulate(
        EngagementEvent( postCategory == $cat, type == EngagementType.SHARE ) over window:time(30d), count(1)
    )
    eval( ( $recentShareCount.doubleValue() / Math.max(1.0, $recentPostCountNum.doubleValue()) ) < ( 0.6 * ( $baseShareCount.doubleValue() / $basePostCount.doubleValue() ) ) )
    not ShareDrop( category == $cat )
then
    System.out.println(">>> Rule B Fired for category: " + $cat);
    insert( new ShareDrop($cat) );
end

// ========= C) NoRescueSignal: nema KOMENTARA u 72h =========
rule "C_no_rescue_signal_72h"
when
  PostPublishedEvent( $cat : category ) over window:time(72h)
  not( EngagementEvent( postCategory == $cat, type == EngagementType.COMMENT ) over window:time(72h) )
  not NoRescueSignal( category == $cat )
then
  System.out.println(">>> Rule C Fired for category: " + $cat);
  insert( new NoRescueSignal($cat) );
end

// ========= D) Konačni alert =========
rule "D_audience_saturation_alert"
// OBRISANO: salience 5
when
  Overposting( $cat : category )
  ShareDrop( category == $cat )
  NoRescueSignal( category == $cat )
  not AudienceSaturationAlert( saturatedCategory == $cat )
then
  System.out.println(">>> Rule D Firing for category: " + $cat);
  String msg = "UPOZORENJE: Zasićenje publike temom '" + $cat +
                 "'. Prevelika učestalost objava dovela je do pada engagementa i drastičnog pada broja deljenja. " +
                 "PREPORUKA: Smanjite učestalost i uvedite novu, srodnu kategoriju.";
  System.out.println("COMPLEX CEP RULE TRIGGERED: " + msg);
  insert( new AudienceSaturationAlert($cat, msg) );
end


// ==================== VIRAL MOMENTUM WINDOW ====================

declare FollowerEngagementSurge
end

declare NicheTrendActive
    hashtag : String
end

// A) Detektuj povećanu aktivnost pratilaca
rule "A_follower_engagement_surge"
when
    $recentEngRate : Number() from accumulate(
        EngagementEvent(type == EngagementType.LIKE || type == EngagementType.COMMENT)
            over window:time(2h),
        count(1)
    )
    $baselineEngRate : Number(doubleValue > 0) from accumulate(
        EngagementEvent(type == EngagementType.LIKE || type == EngagementType.COMMENT)
            over window:time(24h),
        count(1)
    )
    eval($recentEngRate.doubleValue() > 3 * ($baselineEngRate.doubleValue() / 12))
    not FollowerEngagementSurge()
then
    System.out.println(">>> Rule A: Follower engagement SURGE detected!");
    insert(new FollowerEngagementSurge());
end

// B) Detektuj trending topic relevantan za korisnika
rule "B_niche_trend_detected"
when
    User($interests : interests)
    TrendingHashtag($tag : tag)
    eval(InterestMatcher.matchesInterest($interests, $tag))
then
    System.out.println(">>> Rule B: Niche trend detected for hashtag: " + $tag);
    insert(new NicheTrendActive($tag));
end

// C) FINALNI SIGNAL - Viral Momentum Window
rule "C_viral_momentum_window_detected"
when
    FollowerEngagementSurge()
    NicheTrendActive($tag : hashtag)
    not ViralMomentumAlert()
then
    String msg = "VIRAL MOMENTUM WINDOW DETECTED! " +
                 "Your followers are highly active RIGHT NOW and '" + $tag +
                 "' is trending in your niche. Perfect time to post!";
    System.out.println(">>> Rule C (FINAL): " + msg);
    insert(new ViralMomentumAlert(msg, $tag));
end